##############################################

bin/
obj/
*.user
*.suo
*.cache
*.db
*.sqlite
*.log

# NuGet packages
*.nupkg
packages/

# Lock files
project.lock.json

# ASP.NET secrets
appsettings.Development.json
appsettings.Local.json

##############################################
#            VISUAL STUDIO / IDE
##############################################

.vs/
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

##############################################
#              VISUAL STUDIO CODE
##############################################

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

##############################################
#                 DOCKER
##############################################

*.pid
*.sock

##############################################
